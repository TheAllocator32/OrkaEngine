# Public API
# ------------------------------------------------------------

function(shader2shader)
    set(options)
    set(one_value_args ROOT_DIR TARGET OUTPUT_DIR VARYING_DEF)
    set(multi_value_args SOURCES INCLUDE_DIRS DEPENDS)
    cmake_parse_arguments(S2S "${options}" "${one_value_args}" "${multi_value_args}" ${ARGN})

    if(S2S_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "shader2shader: Unknown arguments: ${S2S_UNPARSED_ARGUMENTS}")
    endif()

    if(NOT S2S_ROOT_DIR)
        set(S2S_ROOT_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    endif()
    _orka_shaderc_to_absolute("${CMAKE_CURRENT_SOURCE_DIR}" "${S2S_ROOT_DIR}" S2S_ROOT_DIR)

    if(S2S_OUTPUT_DIR)
        _orka_shaderc_to_absolute("${CMAKE_CURRENT_SOURCE_DIR}" "${S2S_OUTPUT_DIR}" S2S_OUTPUT_DIR)
    endif()

    if(NOT S2S_TARGET)
        set(S2S_TARGET "shader2shader")
    endif()

    if(TARGET "${S2S_TARGET}")
        message(FATAL_ERROR "shader2shader: Target '${S2S_TARGET}' already exists.")
    endif()

    _orka_shaderc_find_executable(_shaderc_exe)
    _orka_shaderc_platform_matrix(_platforms)
    _orka_shaderc_collect_sources("${S2S_ROOT_DIR}" "${S2S_SOURCES}" _sources)
    _orka_shaderc_normalize_include_dirs("${S2S_ROOT_DIR}" "${S2S_INCLUDE_DIRS}" "${_shaderc_exe}" _include_dirs)

    if(NOT _sources)
        message(STATUS "shader2shader: no .sc/.shader sources found in '${S2S_ROOT_DIR}'.")
        return()
    endif()

    set(_outputs)
    set(_total_jobs 0)

    foreach(_src IN LISTS _sources)
        _orka_shaderc_detect_type("${_src}" _shader_type)
        foreach(_entry IN LISTS _platforms)
            string(REPLACE "|" ";" _parts "${_entry}")
            list(GET _parts 0 _ext_suffix)
            list(GET _parts 2 _profile)
            _orka_shaderc_profile_for_type("${_shader_type}" "${_ext_suffix}" "${_profile}" _effective_profile _skip_platform)
            if(_skip_platform)
                continue()
            endif()
            math(EXPR _total_jobs "${_total_jobs} + 1")
        endforeach()
    endforeach()
    set(_job_index 0)

    foreach(_src IN LISTS _sources)
        _orka_shaderc_detect_type("${_src}" _shader_type)
        _orka_shaderc_strip_source_extension("${_src}" _src_no_ext)
        _orka_shaderc_find_varyingdef("${_src}" "${S2S_VARYING_DEF}" _varyingdef)

        foreach(_entry IN LISTS _platforms)
            string(REPLACE "|" ";" _parts "${_entry}")
            list(GET _parts 0 _ext_suffix)
            list(GET _parts 1 _platform)
            list(GET _parts 2 _profile)
            _orka_shaderc_profile_for_type("${_shader_type}" "${_ext_suffix}" "${_profile}" _effective_profile _skip_platform)

            if(_skip_platform)
                continue()
            endif()

            if(S2S_OUTPUT_DIR)
                get_filename_component(_src_dir "${_src}" DIRECTORY)
                get_filename_component(_src_name "${_src_no_ext}" NAME)
                file(RELATIVE_PATH _rel_dir "${S2S_ROOT_DIR}" "${_src_dir}")
                if(_rel_dir STREQUAL ".")
                    set(_out_base "${S2S_OUTPUT_DIR}/${_src_name}")
                else()
                    set(_out_base "${S2S_OUTPUT_DIR}/${_rel_dir}/${_src_name}")
                endif()
            else()
                set(_out_base "${_src_no_ext}")
            endif()

            set(_out_file "${_out_base}.${_ext_suffix}.shader")
            get_filename_component(_out_dir "${_out_file}" DIRECTORY)

            set(_compile_cmd
                    "${_shaderc_exe}"
                    -f "${_src}"
                    -o "${_out_file}"
                    --type "${_shader_type}"
                    --platform "${_platform}"
                    -p "${_effective_profile}"
            )

            foreach(_inc IN LISTS _include_dirs)
                list(APPEND _compile_cmd -i "${_inc}")
            endforeach()

            if(NOT "${_varyingdef}" STREQUAL "")
                list(APPEND _compile_cmd --varyingdef "${_varyingdef}")
            endif()

            set(_deps "${_src}")
            if(NOT "${_varyingdef}" STREQUAL "")
                list(APPEND _deps "${_varyingdef}")
            endif()
            list(APPEND _deps ${S2S_DEPENDS})
            math(EXPR _job_index "${_job_index} + 1")

            add_custom_command(
                    OUTPUT "${_out_file}"
                    COMMAND "${CMAKE_COMMAND}" -E make_directory "${_out_dir}"
                    COMMAND "${CMAKE_COMMAND}" -E echo
                    "[shader2shader ${_job_index}/${_total_jobs}] ${_src} -> ${_out_file}"
                    COMMAND ${_compile_cmd}
                    DEPENDS ${_deps}
                    VERBATIM
                    COMMENT "shader2shader: ${_src} -> ${_out_file}"
            )

            list(APPEND _outputs "${_out_file}")
        endforeach()
    endforeach()

    list(REMOVE_DUPLICATES _outputs)
    add_custom_target("${S2S_TARGET}" DEPENDS ${_outputs})

    # shader2shader is always executed post-install for this target.
    _orka_shaderc_make_identifier("${S2S_TARGET}" _s2s_target_id)
    set(_s2s_hook_guard "ORKA_SHADER2SHADER_POST_INSTALL_HOOKED_${_s2s_target_id}")
    if(NOT DEFINED ${_s2s_hook_guard})
        set(${_s2s_hook_guard} ON CACHE INTERNAL "shader2shader post-install hook registered")
        install(CODE
                "message(STATUS \"Running ${S2S_TARGET} post-install\")\n\
if(DEFINED CMAKE_INSTALL_CONFIG_NAME AND NOT \"\${CMAKE_INSTALL_CONFIG_NAME}\" STREQUAL \"\")\n\
  execute_process(\n\
    COMMAND \"${CMAKE_COMMAND}\" --build \"${CMAKE_BINARY_DIR}\" --target \"${S2S_TARGET}\" --config \"\${CMAKE_INSTALL_CONFIG_NAME}\"\n\
    RESULT_VARIABLE _orka_shader2shader_rc\n\
  )\n\
else()\n\
  execute_process(\n\
    COMMAND \"${CMAKE_COMMAND}\" --build \"${CMAKE_BINARY_DIR}\" --target \"${S2S_TARGET}\"\n\
    RESULT_VARIABLE _orka_shader2shader_rc\n\
  )\n\
endif()\n\
if(NOT _orka_shader2shader_rc EQUAL 0)\n\
  message(FATAL_ERROR \"Post-install shader2shader failed with code \${_orka_shader2shader_rc}\")\n\
endif()\n")
    endif()

    set(${S2S_TARGET}_OUTPUTS "${_outputs}" PARENT_SCOPE)
endfunction()

function(shader2code)
    set(options)
    set(one_value_args ROOT_DIR TARGET OUTPUT_DIR VARYING_DEF VARIABLE_NAME)
    set(multi_value_args SOURCES INCLUDE_DIRS DEPENDS)
    cmake_parse_arguments(S2C "${options}" "${one_value_args}" "${multi_value_args}" ${ARGN})

    if(S2C_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "shader2code: Unknown arguments: ${S2C_UNPARSED_ARGUMENTS}")
    endif()

    if(NOT S2C_ROOT_DIR)
        set(S2C_ROOT_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    endif()
    _orka_shaderc_to_absolute("${CMAKE_CURRENT_SOURCE_DIR}" "${S2C_ROOT_DIR}" S2C_ROOT_DIR)

    if(S2C_OUTPUT_DIR)
        _orka_shaderc_to_absolute("${CMAKE_CURRENT_SOURCE_DIR}" "${S2C_OUTPUT_DIR}" S2C_OUTPUT_DIR)
    endif()

    if(NOT S2C_TARGET)
        set(S2C_TARGET "shader2code")
    endif()

    if(TARGET "${S2C_TARGET}")
        message(FATAL_ERROR "shader2code: Target '${S2C_TARGET}' already exists.")
    endif()

    _orka_shaderc_find_executable(_shaderc_exe)
    _orka_shaderc_platform_matrix(_platforms)
    _orka_shaderc_all_variable_suffixes(_all_suffixes)
    _orka_shaderc_collect_sources("${S2C_ROOT_DIR}" "${S2C_SOURCES}" _sources)
    _orka_shaderc_normalize_include_dirs("${S2C_ROOT_DIR}" "${S2C_INCLUDE_DIRS}" "${_shaderc_exe}" _include_dirs)
    _orka_shaderc_codegen_script(_codegen_script)

    if(NOT _sources)
        message(STATUS "shader2code: no .sc/.shader sources found in '${S2C_ROOT_DIR}'.")
        return()
    endif()

    list(LENGTH _sources _source_count)
    set(_headers)
    set(_group_ids)

    # Build grouped units: name.vert/name.frag -> name.autogenerated.shader.hpp
    foreach(_src IN LISTS _sources)
        _orka_shaderc_detect_type("${_src}" _shader_type)
        _orka_shaderc_strip_source_extension("${_src}" _src_no_ext)
        _orka_shaderc_find_varyingdef("${_src}" "${S2C_VARYING_DEF}" _varyingdef)
        _orka_shaderc_stage_suffix_from_path("${_src}" "${_shader_type}" _stage_suffix)
        _orka_shaderc_group_base_name("${_src_no_ext}" "${_shader_type}" "${_stage_suffix}" _group_base)

        get_filename_component(_src_dir "${_src}" DIRECTORY)
        file(RELATIVE_PATH _rel_dir "${S2C_ROOT_DIR}" "${_src_dir}")
        if(_rel_dir STREQUAL "")
            set(_rel_dir ".")
        endif()

        set(_source_platforms)
        foreach(_entry IN LISTS _platforms)
            string(REPLACE "|" ";" _parts "${_entry}")
            list(GET _parts 0 _ext_suffix)
            list(GET _parts 1 _platform)
            list(GET _parts 2 _profile)
            list(GET _parts 3 _var_suffix)

            _orka_shaderc_profile_for_type("${_shader_type}" "${_ext_suffix}" "${_profile}" _effective_profile _skip_platform)
            if(_skip_platform)
                continue()
            endif()

            list(APPEND _source_platforms "${_ext_suffix}|${_platform}|${_effective_profile}|${_var_suffix}")
        endforeach()
        if(NOT _source_platforms)
            message(WARNING "shader2code: no supported platform/profile combinations for '${_src}'.")
            continue()
        endif()

        set(_group_key "${_rel_dir}::${_group_base}")
        _orka_shaderc_make_identifier("${_group_key}" _group_id)
        list(APPEND _group_ids "${_group_id}")

        set("_grp_${_group_id}_rel_dir" "${_rel_dir}")
        set("_grp_${_group_id}_base" "${_group_base}")

        if(S2C_VARIABLE_NAME)
            if(_source_count GREATER 1)
                set(_raw_group_var "${S2C_VARIABLE_NAME}_${_group_base}")
            else()
                set(_raw_group_var "${S2C_VARIABLE_NAME}")
            endif()
        else()
            set(_raw_group_var "${_group_base}")
        endif()
        _orka_shaderc_make_identifier("${_raw_group_var}" _group_var_name)
        _orka_shaderc_make_identifier("${_group_var_name}_${_stage_suffix}" _stage_var_name)

        list(APPEND "_grp_${_group_id}_sources" "${_src}")
        list(APPEND "_grp_${_group_id}_types" "${_shader_type}")
        string(REPLACE ";" "@" _source_platforms_encoded "${_source_platforms}")
        list(APPEND "_grp_${_group_id}_platform_lists" "${_source_platforms_encoded}")
        list(APPEND "_grp_${_group_id}_varyings" "${_varyingdef}")
        list(APPEND "_grp_${_group_id}_var_names" "${_stage_var_name}")
    endforeach()

    list(REMOVE_DUPLICATES _group_ids)
    foreach(_group_id IN LISTS _group_ids)
        set(_group_rel_dir "${_grp_${_group_id}_rel_dir}")
        set(_group_base "${_grp_${_group_id}_base}")

        if(S2C_OUTPUT_DIR)
            if(_group_rel_dir STREQUAL ".")
                set(_header_file "${S2C_OUTPUT_DIR}/${_group_base}.autogenerated.shader.hpp")
            else()
                set(_header_file "${S2C_OUTPUT_DIR}/${_group_rel_dir}/${_group_base}.autogenerated.shader.hpp")
            endif()
        else()
            if(_group_rel_dir STREQUAL ".")
                set(_header_file "${S2C_ROOT_DIR}/${_group_base}.autogenerated.shader.hpp")
            else()
                set(_header_file "${S2C_ROOT_DIR}/${_group_rel_dir}/${_group_base}.autogenerated.shader.hpp")
            endif()
        endif()

        get_filename_component(_header_dir "${_header_file}" DIRECTORY)
        set(_cleanup_headers)
        foreach(_src IN LISTS _grp_${_group_id}_sources)
            _orka_shaderc_strip_source_extension("${_src}" _legacy_src_no_ext)
            set(_legacy_header "${_legacy_src_no_ext}.autogenerated.shader.hpp")
            if(NOT _legacy_header STREQUAL "${_header_file}")
                list(APPEND _cleanup_headers "${_legacy_header}")
            endif()
        endforeach()
        list(REMOVE_DUPLICATES _cleanup_headers)

        set(_deps "${_codegen_script}")
        foreach(_src IN LISTS _grp_${_group_id}_sources)
            list(APPEND _deps "${_src}")
        endforeach()
        foreach(_vary IN LISTS _grp_${_group_id}_varyings)
            if(NOT "${_vary}" STREQUAL "")
                list(APPEND _deps "${_vary}")
            endif()
        endforeach()
        list(APPEND _deps ${S2C_DEPENDS})

        add_custom_command(
                OUTPUT "${_header_file}"
                COMMAND "${CMAKE_COMMAND}" -E make_directory "${_header_dir}"
                COMMAND "${CMAKE_COMMAND}" -E rm -f "${_header_file}" ${_cleanup_headers}
                COMMAND "${CMAKE_COMMAND}" -E echo
                "[shader2code] generating ${_header_file}"
                COMMAND "${CMAKE_COMMAND}"
                "-DORKA_SHADERC_EXECUTABLE=${_shaderc_exe}"
                "-DORKA_SHADER_OUTPUT_HEADER=${_header_file}"
                "-DORKA_SHADER_SOURCES=${_grp_${_group_id}_sources}"
                "-DORKA_SHADER_TYPES=${_grp_${_group_id}_types}"
                "-DORKA_SHADER_PLATFORM_LISTS=${_grp_${_group_id}_platform_lists}"
                "-DORKA_SHADER_VARIABLE_NAMES=${_grp_${_group_id}_var_names}"
                "-DORKA_SHADER_VARYING_DEFS=${_grp_${_group_id}_varyings}"
                "-DORKA_SHADER_ALL_SUFFIXES=${_all_suffixes}"
                "-DORKA_SHADER_INCLUDE_DIRS=${_include_dirs}"
                -P "${_codegen_script}"
                DEPENDS ${_deps}
                VERBATIM
                COMMENT "shader2code: ${_group_base} -> ${_header_file}"
        )

        list(APPEND _headers "${_header_file}")
    endforeach()

    list(REMOVE_DUPLICATES _headers)
    add_custom_target("${S2C_TARGET}" ALL DEPENDS ${_headers})

    set(${S2C_TARGET}_HEADERS "${_headers}" PARENT_SCOPE)
endfunction()
