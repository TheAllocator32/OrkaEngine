# OrkaShaderC.cmake
#
# CMake helpers for compiling bgfx-style shader sources.
#
# Provided functions:
#   shader2shader(...)
#     Compiles every discovered .sc/.shader source into .<platform>.shader binaries.
#
#   shader2code(...)
#     Compiles every discovered .sc/.shader source into
#     <shadername>.autogenerated.shader.hpp with embedded binary arrays.
#
# Example:
#   include("OrkaShaderC.cmake")
#   shader2shader(ROOT_DIR "${CMAKE_CURRENT_SOURCE_DIR}/src" TARGET shader_binaries)
#   shader2code(ROOT_DIR "${CMAKE_CURRENT_SOURCE_DIR}/src" TARGET shader_headers)

if(COMMAND include_guard)
    include_guard(GLOBAL)
endif()

# ------------------------------------------------------------
# Internal helpers
# ------------------------------------------------------------

function(_orka_shaderc_strip_source_extension input_path output_var)
    if(input_path MATCHES "\\.sc$")
        string(REGEX REPLACE "\\.sc$" "" _out "${input_path}")
    elseif(input_path MATCHES "\\.shader$")
        string(REGEX REPLACE "\\.shader$" "" _out "${input_path}")
    else()
        set(_out "${input_path}")
    endif()
    set(${output_var} "${_out}" PARENT_SCOPE)
endfunction()

function(_orka_shaderc_make_identifier raw_name output_var)
    set(_name "${raw_name}")
    string(REGEX REPLACE "[^A-Za-z0-9_]" "_" _name "${_name}")

    if(_name STREQUAL "")
        set(_name "shader_data")
    endif()

    string(SUBSTRING "${_name}" 0 1 _first)
    if(_first MATCHES "[0-9]")
        set(_name "_${_name}")
    endif()

    set(${output_var} "${_name}" PARENT_SCOPE)
endfunction()

function(_orka_shaderc_detect_type shader_file output_var)
    get_filename_component(_filename "${shader_file}" NAME)
    string(TOLOWER "${_filename}" _lower)

    if(_lower MATCHES "(^|[._-])vs([._-]|$)" OR _lower MATCHES "(^|[._-])vert([._-]|$)" OR _lower MATCHES "vertex")
        set(_type "vertex")
    elseif(_lower MATCHES "(^|[._-])fs([._-]|$)" OR _lower MATCHES "(^|[._-])frag([._-]|$)" OR _lower MATCHES "fragment")
        set(_type "fragment")
    elseif(_lower MATCHES "(^|[._-])cs([._-]|$)" OR _lower MATCHES "(^|[._-])comp([._-]|$)" OR _lower MATCHES "compute")
        set(_type "compute")
    else()
        message(FATAL_ERROR
                "shader2shader/shader2code: Could not detect shader type for '${shader_file}'.\n"
                "Please use names containing vs/fs/cs (or vertex/fragment/compute)."
        )
    endif()

    set(${output_var} "${_type}" PARENT_SCOPE)
endfunction()

function(_orka_shaderc_stage_suffix_from_path shader_file shader_type output_var)
    get_filename_component(_filename "${shader_file}" NAME)
    string(TOLOWER "${_filename}" _lower)

    if(shader_type STREQUAL "vertex")
        if(_lower MATCHES "(^|[._-])(vs|vert|vertex)([._-]|$)")
            set(_suffix "vert")
        else()
            set(_suffix "vertex")
        endif()
    elseif(shader_type STREQUAL "fragment")
        if(_lower MATCHES "(^|[._-])(fs|frag|fragment)([._-]|$)")
            set(_suffix "frag")
        else()
            set(_suffix "fragment")
        endif()
    else()
        if(_lower MATCHES "(^|[._-])(cs|comp|compute)([._-]|$)")
            set(_suffix "comp")
        else()
            set(_suffix "compute")
        endif()
    endif()

    set(${output_var} "${_suffix}" PARENT_SCOPE)
endfunction()

function(_orka_shaderc_group_base_name source_no_ext shader_type stage_suffix output_var)
    get_filename_component(_name "${source_no_ext}" NAME)
    set(_base "${_name}")

    # For the expected name.vert/name.frag scheme, merge both stages into one output header.
    # Also supports name.vs/name.fs and name.vertex/name.fragment.
    if(shader_type STREQUAL "vertex")
        string(REGEX REPLACE "(^.*)[._-](vs|vert|vertex)$" "\\1" _candidate "${_name}")
        if(NOT _candidate STREQUAL "${_name}")
            set(_base "${_candidate}")
        endif()
    elseif(shader_type STREQUAL "fragment")
        string(REGEX REPLACE "(^.*)[._-](fs|frag|fragment)$" "\\1" _candidate "${_name}")
        if(NOT _candidate STREQUAL "${_name}")
            set(_base "${_candidate}")
        endif()
    endif()

    # Compute shaders remain standalone by default.
    set(${output_var} "${_base}" PARENT_SCOPE)
endfunction()

function(_orka_shaderc_to_absolute base_dir maybe_relative output_var)
    if(IS_ABSOLUTE "${maybe_relative}")
        set(_abs "${maybe_relative}")
    else()
        get_filename_component(_abs "${base_dir}/${maybe_relative}" ABSOLUTE)
    endif()
    set(${output_var} "${_abs}" PARENT_SCOPE)
endfunction()

function(_orka_shaderc_find_executable output_var)
    if(DEFINED ORKA_SHADERC_EXECUTABLE AND EXISTS "${ORKA_SHADERC_EXECUTABLE}")
        set(${output_var} "${ORKA_SHADERC_EXECUTABLE}" PARENT_SCOPE)
        return()
    endif()

    set(_hints)
    if(DEFINED VCPKG_INSTALLED_DIR)
        if(DEFINED VCPKG_TARGET_TRIPLET)
            list(APPEND _hints "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/tools/bgfx")
        endif()
        file(GLOB _vcpkg_tools_dirs "${VCPKG_INSTALLED_DIR}/*/tools/bgfx")
        list(APPEND _hints ${_vcpkg_tools_dirs})
    endif()

    get_filename_component(_module_dir "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
    if(DEFINED VCPKG_TARGET_TRIPLET)
        list(APPEND _hints
                "${CMAKE_SOURCE_DIR}/vcpkg/installed/${VCPKG_TARGET_TRIPLET}/tools/bgfx"
                "${CMAKE_CURRENT_SOURCE_DIR}/vcpkg/installed/${VCPKG_TARGET_TRIPLET}/tools/bgfx"
                "${_module_dir}/vcpkg/installed/${VCPKG_TARGET_TRIPLET}/tools/bgfx"
        )
    endif()
    file(GLOB _source_vcpkg_tools "${CMAKE_SOURCE_DIR}/vcpkg/installed/*/tools/bgfx")
    file(GLOB _current_vcpkg_tools "${CMAKE_CURRENT_SOURCE_DIR}/vcpkg/installed/*/tools/bgfx")
    file(GLOB _module_vcpkg_tools "${_module_dir}/vcpkg/installed/*/tools/bgfx")
    list(APPEND _hints ${_source_vcpkg_tools} ${_current_vcpkg_tools} ${_module_vcpkg_tools})
    list(REMOVE_DUPLICATES _hints)

    find_program(_shaderc_exe NAMES shaderc shaderc.exe HINTS ${_hints})
    if(NOT _shaderc_exe)
        message(FATAL_ERROR
                "shader2shader/shader2code: Could not find bgfx shaderc executable.\n"
                "Set ORKA_SHADERC_EXECUTABLE manually, or install bgfx tools via vcpkg."
        )
    endif()

    set(${output_var} "${_shaderc_exe}" PARENT_SCOPE)
endfunction()

function(_orka_shaderc_default_include_dirs output_var)
    set(_dirs)

    # User-provided global list (optional).
    if(DEFINED ORKA_SHADER_INCLUDE_DIRS)
        list(APPEND _dirs ${ORKA_SHADER_INCLUDE_DIRS})
    endif()

    # Common bgfx include variable from find_package(bgfx).
    if(DEFINED BGFX_INCLUDE_DIRS)
        foreach(_inc IN LISTS BGFX_INCLUDE_DIRS)
            list(APPEND _dirs "${_inc}")
            if(EXISTS "${_inc}/bgfx")
                list(APPEND _dirs "${_inc}/bgfx")
            endif()
        endforeach()
    endif()

    # Typical vcpkg locations where bgfx_shader.sh lives.
    if(DEFINED VCPKG_INSTALLED_DIR AND DEFINED VCPKG_TARGET_TRIPLET)
        list(APPEND _dirs "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/include/bgfx")
    endif()

    if(DEFINED VCPKG_TARGET_TRIPLET)
        list(APPEND _dirs
                "${CMAKE_SOURCE_DIR}/vcpkg/installed/${VCPKG_TARGET_TRIPLET}/include/bgfx"
                "${CMAKE_CURRENT_SOURCE_DIR}/vcpkg/installed/${VCPKG_TARGET_TRIPLET}/include/bgfx"
        )
    endif()

    set(_existing)
    foreach(_d IN LISTS _dirs)
        if(NOT _d STREQUAL "" AND EXISTS "${_d}")
            list(APPEND _existing "${_d}")
        endif()
    endforeach()

    list(REMOVE_DUPLICATES _existing)
    set(${output_var} "${_existing}" PARENT_SCOPE)
endfunction()

function(_orka_shaderc_find_varyingdef shader_file explicit_varying output_var)
    set(_varying "")

    if(NOT "${explicit_varying}" STREQUAL "")
        if(IS_ABSOLUTE "${explicit_varying}" AND EXISTS "${explicit_varying}")
            set(_varying "${explicit_varying}")
        elseif(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/${explicit_varying}")
            set(_varying "${CMAKE_CURRENT_SOURCE_DIR}/${explicit_varying}")
        elseif(EXISTS "${CMAKE_SOURCE_DIR}/${explicit_varying}")
            set(_varying "${CMAKE_SOURCE_DIR}/${explicit_varying}")
        else()
            message(FATAL_ERROR "shader2shader/shader2code: VARYING_DEF not found: ${explicit_varying}")
        endif()

        set(${output_var} "${_varying}" PARENT_SCOPE)
        return()
    endif()

    get_filename_component(_dir "${shader_file}" DIRECTORY)
    while(TRUE)
        if(EXISTS "${_dir}/varying.def.sc")
            set(_varying "${_dir}/varying.def.sc")
            break()
        endif()

        get_filename_component(_parent "${_dir}" DIRECTORY)
        if(_parent STREQUAL _dir)
            break()
        endif()
        set(_dir "${_parent}")
    endwhile()

    set(${output_var} "${_varying}" PARENT_SCOPE)
endfunction()

function(_orka_shaderc_platform_matrix output_var)
    # Format per entry:
    #   extension|shaderc_platform|shaderc_profile|embedded_variable_suffix
    if(WIN32)
        set(_entries
                "gln|windows|150|GL"
                "glo|windows|120|GL_LEGACY"
                "gles|windows|300_es|GLES"
                "web|asm.js|100_es|WEBGL"
                "vk|windows|spirv|vulkan"
                "dx11|windows|s_4_0|dx11"
                "dx12|windows|s_5_0|dx12"
        )
    elseif(APPLE)
        set(_entries
                "gln|osx|150|GL"
                "glo|osx|120|GL_LEGACY"
                "gles|ios|300_es|GLES"
                "web|asm.js|100_es|WEBGL"
                "mt|osx|metal|metal"
        )
    else()
        # Linux / other unix-like hosts.
        set(_entries
                "gln|linux|150|GL"
                "glo|linux|120|GL_LEGACY"
                "gles|linux|300_es|GLES"
                "web|asm.js|100_es|WEBGL"
                "vk|linux|spirv|vulkan"
        )
    endif()

    set(${output_var} "${_entries}" PARENT_SCOPE)
endfunction()

function(_orka_shaderc_all_variable_suffixes output_var)
    # Keep this list stable across all hosts so generated headers always expose
    # the same platform symbol set (real or stub).
    set(_suffixes
            "GL"
            "GL_LEGACY"
            "GLES"
            "WEBGL"
            "vulkan"
            "dx11"
            "dx12"
            "metal"
    )
    set(${output_var} "${_suffixes}" PARENT_SCOPE)
endfunction()

function(_orka_shaderc_profile_for_type shader_type ext_suffix default_profile output_profile output_skip)
    set(_profile "${default_profile}")
    set(_skip OFF)

    if(shader_type STREQUAL "compute")
        if(ext_suffix STREQUAL "glo" OR ext_suffix STREQUAL "web")
            # Compute shaders are not supported on GLSL 1.x / WebGL1 targets.
            set(_skip ON)
        elseif(ext_suffix STREQUAL "gln")
            set(_profile "430")
        elseif(ext_suffix STREQUAL "gles")
            set(_profile "310_es")
        elseif(ext_suffix STREQUAL "dx11" OR ext_suffix STREQUAL "dx12")
            set(_profile "s_5_0")
        elseif(ext_suffix STREQUAL "vk")
            set(_profile "spirv")
        elseif(ext_suffix STREQUAL "mt")
            set(_profile "metal")
        endif()
    endif()

    set(${output_profile} "${_profile}" PARENT_SCOPE)
    set(${output_skip} "${_skip}" PARENT_SCOPE)
endfunction()

function(_orka_shaderc_collect_sources root_dir explicit_sources output_var)
    set(_sources)

    if(NOT "${explicit_sources}" STREQUAL "")
        foreach(_src IN LISTS explicit_sources)
            _orka_shaderc_to_absolute("${root_dir}" "${_src}" _abs)
            if(EXISTS "${_abs}")
                list(APPEND _sources "${_abs}")
            else()
                message(WARNING "shader2shader/shader2code: source not found and will be skipped: ${_src}")
            endif()
        endforeach()
    else()
        file(GLOB_RECURSE _globbed CONFIGURE_DEPENDS
                "${root_dir}/*.sc"
                "${root_dir}/*.shader"
        )

        foreach(_src IN LISTS _globbed)
            string(REPLACE "\\" "/" _normalized "${_src}")

            # Avoid compiling vendored/tool directories when using broad roots.
            if(_normalized MATCHES "/vcpkg/" OR _normalized MATCHES "/cmake-build" OR _normalized MATCHES "/build/")
                continue()
            endif()

            # Skip already compiled shader binaries.
            if(_normalized MATCHES "\\.(gln|glo|gles|web|vk|dx11|dx12|mt)\\.shader$")
                continue()
            endif()

            # bgfx varying declaration file, not a standalone shader stage.
            if(_normalized MATCHES "/varying\\.def\\.sc$")
                continue()
            endif()

            list(APPEND _sources "${_src}")
        endforeach()
    endif()

    list(REMOVE_DUPLICATES _sources)
    set(${output_var} "${_sources}" PARENT_SCOPE)
endfunction()

function(_orka_shaderc_normalize_include_dirs root_dir include_dirs shaderc_executable output_var)
    _orka_shaderc_default_include_dirs(_default_inc)
    set(_all_inc ${_default_inc})

    # Infer include/bgfx from .../tools/bgfx/shaderc when possible.
    if(NOT "${shaderc_executable}" STREQUAL "")
        get_filename_component(_shaderc_dir "${shaderc_executable}" DIRECTORY)
        get_filename_component(_tools_dir "${_shaderc_dir}" DIRECTORY)
        get_filename_component(_triplet_dir "${_tools_dir}" DIRECTORY)
        if(EXISTS "${_triplet_dir}/include/bgfx")
            list(APPEND _all_inc "${_triplet_dir}/include/bgfx")
        endif()
    endif()

    foreach(_inc IN LISTS include_dirs)
        _orka_shaderc_to_absolute("${root_dir}" "${_inc}" _abs)
        list(APPEND _all_inc "${_abs}")
    endforeach()

    set(_existing)
    foreach(_inc IN LISTS _all_inc)
        if(NOT _inc STREQUAL "" AND EXISTS "${_inc}")
            list(APPEND _existing "${_inc}")
        endif()
    endforeach()

    list(REMOVE_DUPLICATES _existing)
    set(${output_var} "${_existing}" PARENT_SCOPE)
endfunction()

function(_orka_shaderc_codegen_script output_var)
    set(_script_path "${CMAKE_BINARY_DIR}/orka_shader2code_generator.cmake")
    set(_script_tmp "${_script_path}.tmp")

    # The generator is an explicit dependency of every generated header.  Do not
    # update its timestamp on each configure, otherwise every header becomes
    # stale and shaderc recompiles all shaders after a CMake rerun.
    file(WRITE "${_script_tmp}" [=[
# Generated helper script for shader2code.

if(NOT DEFINED ORKA_SHADERC_EXECUTABLE OR NOT EXISTS "${ORKA_SHADERC_EXECUTABLE}")
    message(FATAL_ERROR "shader2code: ORKA_SHADERC_EXECUTABLE is missing or invalid.")
endif()

if(NOT DEFINED ORKA_SHADER_OUTPUT_HEADER OR ORKA_SHADER_OUTPUT_HEADER STREQUAL "")
    message(FATAL_ERROR "shader2code: ORKA_SHADER_OUTPUT_HEADER is missing.")
endif()

if(NOT DEFINED ORKA_SHADER_SOURCES OR ORKA_SHADER_SOURCES STREQUAL "")
    message(FATAL_ERROR "shader2code: ORKA_SHADER_SOURCES is empty.")
endif()

if(NOT DEFINED ORKA_SHADER_TYPES OR ORKA_SHADER_TYPES STREQUAL "")
    message(FATAL_ERROR "shader2code: ORKA_SHADER_TYPES is empty.")
endif()

if(NOT DEFINED ORKA_SHADER_VARIABLE_NAMES OR ORKA_SHADER_VARIABLE_NAMES STREQUAL "")
    message(FATAL_ERROR "shader2code: ORKA_SHADER_VARIABLE_NAMES is empty.")
endif()

if(NOT DEFINED ORKA_SHADER_PLATFORM_LISTS OR ORKA_SHADER_PLATFORM_LISTS STREQUAL "")
    message(FATAL_ERROR "shader2code: ORKA_SHADER_PLATFORM_LISTS is empty.")
endif()

if(NOT DEFINED ORKA_SHADER_VARYING_DEFS)
    set(ORKA_SHADER_VARYING_DEFS "")
endif()

if(NOT DEFINED ORKA_SHADER_ALL_SUFFIXES OR ORKA_SHADER_ALL_SUFFIXES STREQUAL "")
    message(FATAL_ERROR "shader2code: ORKA_SHADER_ALL_SUFFIXES is empty.")
endif()

function(_orka_hex_to_cpp hex_string output_var)
    string(TOUPPER "${hex_string}" _hex_upper)
    string(LENGTH "${_hex_upper}" _len)

    set(_result "")
    set(_line "")

    if(_len GREATER 0)
        math(EXPR _max "${_len} - 2")
        foreach(_idx RANGE 0 ${_max} 2)
            string(SUBSTRING "${_hex_upper}" ${_idx} 2 _byte)
            string(APPEND _line "0x${_byte}, ")

            math(EXPR _byte_index "${_idx} / 2")
            math(EXPR _mod "${_byte_index} % 12")
            if(_mod EQUAL 11)
                string(APPEND _result "  ${_line}\n")
                set(_line "")
            endif()
        endforeach()
    endif()

    if(NOT _line STREQUAL "")
        string(APPEND _result "  ${_line}\n")
    endif()

    set(${output_var} "${_result}" PARENT_SCOPE)
endfunction()

get_filename_component(_header_dir "${ORKA_SHADER_OUTPUT_HEADER}" DIRECTORY)
file(MAKE_DIRECTORY "${_header_dir}")

set(_tmp_dir "${ORKA_SHADER_OUTPUT_HEADER}.tmp")
file(REMOVE_RECURSE "${_tmp_dir}")
file(MAKE_DIRECTORY "${_tmp_dir}")

set(_header_text "/* Auto-generated by shader2code. Do not edit. */\n")
string(APPEND _header_text "#pragma once\n\n")
string(APPEND _header_text "#include <cstdint>\n\n")
list(LENGTH ORKA_SHADER_SOURCES _count_sources)
list(LENGTH ORKA_SHADER_TYPES _count_types)
list(LENGTH ORKA_SHADER_VARIABLE_NAMES _count_vars)
list(LENGTH ORKA_SHADER_PLATFORM_LISTS _count_platform_lists)
list(LENGTH ORKA_SHADER_VARYING_DEFS _count_varyings)

if(NOT _count_sources EQUAL _count_types OR NOT _count_sources EQUAL _count_vars)
    message(FATAL_ERROR "shader2code: ORKA_SHADER_SOURCES/TYPES/VARIABLE_NAMES length mismatch.")
endif()
if(NOT _count_sources EQUAL _count_platform_lists)
    message(FATAL_ERROR "shader2code: ORKA_SHADER_PLATFORM_LISTS length mismatch.")
endif()

if(_count_varyings EQUAL 0)
    set(ORKA_SHADER_VARYING_DEFS "")
    list(LENGTH ORKA_SHADER_VARYING_DEFS _count_varyings)
endif()
if(NOT _count_sources EQUAL _count_varyings)
    message(FATAL_ERROR "shader2code: ORKA_SHADER_VARYING_DEFS length mismatch.")
endif()

set(_generated_symbol_keys "")
set(_total_compiles 0)
foreach(_platform_list_encoded IN LISTS ORKA_SHADER_PLATFORM_LISTS)
    string(REPLACE "@" ";" _platform_list_tmp "${_platform_list_encoded}")
    list(LENGTH _platform_list_tmp _platform_count)
    math(EXPR _total_compiles "${_total_compiles} + ${_platform_count}")
endforeach()
set(_compile_index 0)
math(EXPR _last_index "${_count_sources} - 1")
foreach(_src_idx RANGE 0 ${_last_index})
    list(GET ORKA_SHADER_SOURCES "${_src_idx}" _shader_source)
    list(GET ORKA_SHADER_TYPES "${_src_idx}" _shader_type)
    list(GET ORKA_SHADER_VARIABLE_NAMES "${_src_idx}" _var_name)
    list(GET ORKA_SHADER_PLATFORM_LISTS "${_src_idx}" _platform_list_encoded)
    list(GET ORKA_SHADER_VARYING_DEFS "${_src_idx}" _varying_def)

    if(NOT EXISTS "${_shader_source}")
        file(REMOVE_RECURSE "${_tmp_dir}")
        message(FATAL_ERROR "shader2code: source does not exist: ${_shader_source}")
    endif()

    # Keep the input identity in the generated file.  Besides making generated
    # headers auditable, this makes it immediately clear which shader revision
    # produced their embedded binaries.
    file(SHA256 "${_shader_source}" _shader_source_hash)
    get_filename_component(_shader_source_name "${_shader_source}" NAME)
    string(APPEND _header_text "// Source SHA-256 (${_shader_source_name}): ${_shader_source_hash}\n\n")

    string(REPLACE "@" ";" _platform_list "${_platform_list_encoded}")
    foreach(_entry IN LISTS _platform_list)
        string(REPLACE "|" ";" _parts "${_entry}")
        list(LENGTH _parts _parts_len)
        if(NOT _parts_len EQUAL 4)
            file(REMOVE_RECURSE "${_tmp_dir}")
            message(FATAL_ERROR "shader2code: Invalid platform entry '${_entry}'")
        endif()

        list(GET _parts 0 _ext_suffix)
        list(GET _parts 1 _platform)
        list(GET _parts 2 _profile)
        list(GET _parts 3 _var_suffix)

        set(_binary_path "${_tmp_dir}/shader_${_src_idx}.${_ext_suffix}.bin")
        set(_compile_cmd
            "${ORKA_SHADERC_EXECUTABLE}"
            -f "${_shader_source}"
            -o "${_binary_path}"
            --type "${_shader_type}"
            --platform "${_platform}"
            -p "${_profile}"
        )

        foreach(_inc IN LISTS ORKA_SHADER_INCLUDE_DIRS)
            if(NOT "${_inc}" STREQUAL "")
                list(APPEND _compile_cmd -i "${_inc}")
            endif()
        endforeach()

        if(NOT "${_varying_def}" STREQUAL "")
            list(APPEND _compile_cmd --varyingdef "${_varying_def}")
        endif()

        math(EXPR _compile_index "${_compile_index} + 1")
        message(STATUS
            "[shader2code ${_compile_index}/${_total_compiles}] "
            "${_shader_source} -> ${_var_name}_${_var_suffix} (${_platform}/${_profile})"
        )

        execute_process(
            COMMAND ${_compile_cmd}
            RESULT_VARIABLE _rc
            OUTPUT_VARIABLE _stdout
            ERROR_VARIABLE _stderr
        )

        if(NOT _rc EQUAL 0)
            file(REMOVE_RECURSE "${_tmp_dir}")
            message(FATAL_ERROR
                "shader2code failed for ${_shader_source} (${_platform}/${_profile}).\n"
                "Command: ${_compile_cmd}\n"
                "stdout:\n${_stdout}\n"
                "stderr:\n${_stderr}"
            )
        endif()

        file(READ "${_binary_path}" _hex_content HEX)
        file(SIZE "${_binary_path}" _binary_size)
        _orka_hex_to_cpp("${_hex_content}" _cpp_bytes)

        string(APPEND _header_text "static const uint8_t ${_var_name}_${_var_suffix}[] = {\n${_cpp_bytes}};\n")
        string(APPEND _header_text "static const uint32_t ${_var_name}_${_var_suffix}_len = ${_binary_size};\n\n")
        list(APPEND _generated_symbol_keys "${_var_name}|${_var_suffix}")
    endforeach()

    foreach(_suffix IN LISTS ORKA_SHADER_ALL_SUFFIXES)
        set(_key "${_var_name}|${_suffix}")
        list(FIND _generated_symbol_keys "${_key}" _idx)
        if(_idx EQUAL -1)
            string(APPEND _header_text "static const uint8_t ${_var_name}_${_suffix}[] = { 0x00 };\n")
            string(APPEND _header_text "static const uint32_t ${_var_name}_${_suffix}_len = 0;\n\n")
            list(APPEND _generated_symbol_keys "${_key}")
        endif()
    endforeach()
endforeach()

file(WRITE "${ORKA_SHADER_OUTPUT_HEADER}" "${_header_text}")
file(REMOVE_RECURSE "${_tmp_dir}")
]=])

    execute_process(
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${_script_tmp}" "${_script_path}"
        RESULT_VARIABLE _copy_result
    )
    file(REMOVE "${_script_tmp}")
    if(NOT _copy_result EQUAL 0)
        message(FATAL_ERROR "shader2code: failed to update generator script '${_script_path}'.")
    endif()

    set(${output_var} "${_script_path}" PARENT_SCOPE)
endfunction()

